{
  "about": "Hand-labelled answer key for data/erp/01_vendor_master.sql. LEIs, legal names and registration statuses were checked against GLEIF, CIKs and SIC codes against SEC EDGAR, on 23 Oct 2026. The batches were fixed before any rule existed: rules are learned from the learning batch only and scored on the held-out batch.",
  "patterns": {
    "sic_not_in_registry": {
      "origin": "real",
      "learnable": true,
      "description": "EDGAR files the company under an SIC code that the company_dns list of 1,005 codes does not contain: an industry-group code such as 3570 or 2840, or an SEC-only code such as 3576."
    },
    "lei_of_other_entity": {
      "origin": "seeded",
      "learnable": true,
      "description": "The claimed LEI belongs to a same-name entity registered in another country."
    },
    "lei_lapsed": {
      "origin": "real",
      "learnable": true,
      "description": "The claimed LEI is the supplier's own, but its GLEIF registration has lapsed."
    },
    "name_not_legal_name": {
      "origin": "seeded",
      "learnable": true,
      "description": "The ERP name is a trading name, a former name or a typo of the registered legal name."
    },
    "no_registry_coverage": {
      "origin": "synthetic",
      "learnable": true,
      "description": "A fictional small supplier from a country with little registry coverage: no registry can confirm it, so documents are requested and the supplier is not penalised."
    },
    "blank_field": {
      "origin": "seeded",
      "learnable": false,
      "description": "The ERP field is blank and a registry supplies the value."
    },
    "ambiguous_identity": {
      "origin": "real",
      "learnable": false,
      "description": "The name and country match more than one registered legal entity, listed as candidate LEIs, so no single entity can be chosen."
    }
  },
