# Zetaris (data layer)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift, the only AI provider: the URL and Runtime token from Nightshift's Console
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token

# Identifies us to SEC EDGAR and company_dns: an app name and a contact email
SEC_USER_AGENT=Provenance your-email@example.com

# Password for the synthetic ERP database in docker-compose.yml: a strong value without quotes, \ or $
ERP_DB_PASSWORD=choose-a-strong-password

# Runtime behaviour: SAMPLE_MODE=true replays data/sample/recording.json, with no Zetaris, Nightshift or network
SAMPLE_MODE=false
# The port POST /run is served on
PORT=8000
