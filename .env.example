# Zetaris (data layer)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Identifies us to SEC EDGAR and company_dns: an app name and a contact email
SEC_USER_AGENT=Provenance your-email@example.com

# Password for the synthetic ERP database in docker-compose.yml: a strong value without quotes, \ or $
ERP_DB_PASSWORD=choose-a-strong-password
